[
  {
    "id": "usgs_inject",
    "type": "inject",
    "name": "Buscar sismos USGS",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 170,
    "y": 100,
    "wires": [["usgs_http"]]
  },
  {
    "id": "usgs_http",
    "type": "http request",
    "name": "USGS GeoJSON",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "https://earthquake.usgs.gov/fdsnws/event/1/query?format=geojson&minmagnitude=2.5&orderby=time&limit=200",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 400,
    "y": 100,
    "wires": [["usgs_fn"]]
  },
  {
    "id": "usgs_fn",
    "type": "function",
    "name": "GeoJSON para INSERT",
    "func": "const feats = (msg.payload && msg.payload.features) || [];\nif (!feats.length) {\n    node.warn('USGS: sem eventos');\n    return null;\n}\nconst ids = feats.map(f => f.id);\nconst payloads = feats.map(f => JSON.stringify(f));\nmsg.query = `INSERT INTO raw_sismos (fonte, formato, id_externo, payload)\n             SELECT 'USGS', 'geojson', t.id, t.p\n             FROM UNNEST($1::text[], $2::text[]) AS t(id, p)\n             ON CONFLICT (fonte, id_externo) DO NOTHING`;\nmsg.params = [ids, payloads];\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 650,
    "y": 100,
    "wires": [["usgs_pg"]]
  },
  {
    "id": "usgs_pg",
    "type": "postgresql",
    "name": "INSERT raw_sismos",
    "query": "",
    "postgreSQLConfig": "pg_config",
    "split": false,
    "rowsPerMsg": 1,
    "outputs": 1,
    "x": 890,
    "y": 100,
    "wires": [["usgs_dbg"]]
  },
  {
    "id": "usgs_dbg",
    "type": "debug",
    "name": "Resultado",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "true",
    "targetType": "full",
    "x": 1110,
    "y": 100,
    "wires": []
  },
  {
    "id": "pg_config",
    "type": "postgreSQLConfig",
    "name": "Postgres sismos",
    "host": "postgres",
    "hostFieldType": "str",
    "port": 5432,
    "portFieldType": "num",
    "database": "sismos",
    "databaseFieldType": "str",
    "ssl": "false",
    "sslFieldType": "bool",
    "applicationName": "",
    "applicationNameType": "str",
    "max": 10,
    "maxFieldType": "num",
    "idle": 1000,
    "idleFieldType": "num",
    "connectionTimeout": 10000,
    "connectionTimeoutFieldType": "num",
    "user": "sismos",
    "userFieldType": "str",
    "password": "sismos123",
    "passwordFieldType": "str"
  }
]
